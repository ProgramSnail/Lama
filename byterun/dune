(rule
 (target byterun.exe)
 (deps
  (:include (source_tree include))
  (:main src/cli.c src/interpreter.c)
  (:parser src/parser.c)
  (:utils src/types.c)
  (:runtime ../runtime/runtime.a))
 (mode
  (promote (until-clean)))
 (action
  (run gcc -Iinclude/ %{main} %{parser} %{utils} %{runtime} -o %{target})))
